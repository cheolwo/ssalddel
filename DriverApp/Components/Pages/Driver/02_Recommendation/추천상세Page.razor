@page "/driver/recommendations/{의뢰Id}"
@inject IDriverSampleDataService Samples
@inject IAuthSession AuthSession
@inject IDriverRecommendationDecisionService DecisionService

<PageTitle>추천상세</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">추천 상세</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">추천 사유, 거리, 수익을 보고 수락/거절을 판단한다.</MudText>
            </MudStack>
        </MudPaper>

        @if (_데이터로딩중)
        {
            <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary">추천 상세를 불러오고 있습니다.</MudText>
        }
        else if (!_인증됨)
        {
            <MudAlert Severity="Severity.Warning">
                추천 상세는 기사 로그인 후 확인할 수 있습니다.
                <MudButton Class="ml-2"
                           Variant="Variant.Filled"
                           Color="Color.Primary"
                           Href="@DriverRoutes.LoginFor(DriverRoutes.RecommendationDetail(의뢰Id))">
                    로그인하고 상세 보기
                </MudButton>
            </MudAlert>
        }
        else if (!string.IsNullOrWhiteSpace(_데이터오류))
        {
            <MudAlert Severity="Severity.Error">
                @_데이터오류
                <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" OnClick="재조회Async">다시 시도</MudButton>
            </MudAlert>
        }
        else if (의뢰 is null)
        {
            <MudAlert Severity="Severity.Warning">
                추천 의뢰 정보를 찾지 못했습니다. 이미 처리되었거나 추천 목록에서 내려간 의뢰일 수 있습니다.
                <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Recommendations">추천 목록으로</MudButton>
            </MudAlert>
        }
        else
        {
            <MudPaper Class="driver-recommendation-card pa-4" Elevation="0">
                <MudStack Spacing="2">
                    <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Start" Wrap="Wrap.Wrap" Class="driver-recommendation-card__head">
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.h6">@의뢰.화물종류</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@의뢰.요약설명</MudText>
                            <DriverRecommendationTypeChips Request="@의뢰" />
                        </MudStack>
                        <MudStack Spacing="0" AlignItems="AlignItems.End" Class="driver-recommendation-card__fare">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">예상 수익</MudText>
                            <MudText Typo="Typo.h6" Color="Color.Error">@((의뢰.예상수익 ?? 0m).ToString("0"))원</MudText>
                        </MudStack>
                    </MudStack>

                    @{ var warningState = WarningState; }
                    <RecommendationWarningBadges RequiresSpecialPickup="@warningState.RequiresSpecialPickup"
                                                 RequiresSpecialDropoff="@warningState.RequiresSpecialDropoff"
                                                 ShowReceipt="@warningState.ShowReceipt" />

                    <DriverRoutePaymentSummary PickupTitle="@의뢰.픽업지"
                                               PickupSubtitle="@PickupDistanceText(의뢰)"
                                               PickupMeta="@PickupMeta(의뢰)"
                                               DropoffTitle="@의뢰.하차지"
                                               DropoffSubtitle="@TransportDistanceText(의뢰)"
                                               DropoffMeta="@DropoffMeta(의뢰)"
                                               PaymentItems="@PaymentItems(의뢰)" />

                    <MudText Typo="Typo.body1">@의뢰.상세설명</MudText>
                    @if (의뢰.공동주문운송여부)
                    {
                        <MudPaper Elevation="0" Outlined="true" Class="pa-3">
                            <MudStack Spacing="2">
                                <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Wrap="Wrap.Wrap">
                                    <MudText Typo="Typo.subtitle2">공동구매 운송 책임 범위</MudText>
                                    <MudChip T="string" Color="Color.Warning" Variant="Variant.Filled">@의뢰.세대배송범위표시</MudChip>
                                </MudStack>
                                <MudText Typo="Typo.body2">
                                    이 의뢰는 보세구역 또는 국내 물류 거점에서 공동주택으로 이동하는 공동구매 화물입니다. 수락 전 세대별 분류 상태와 기사 업무 범위를 확인해야 합니다.
                                </MudText>
                                <MudList T="string" Dense="true">
                                    <MudListItem Icon="@Icons.Material.Filled.Inventory2">
                                        상차 전 상품정보 스티커 또는 세대별 송장 라벨이 실제 화물과 맞는지 확인
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Filled.QrCodeScanner">
                                        바코드가 있는 경우 스캔 결과가 수량과 배송 대상에 맞는지 확인
                                    </MudListItem>
                                    <MudListItem Icon="@Icons.Material.Filled.DoorFront">
                                        세대 문앞 배송이 포함된 경우 세대별 배송 건수와 동선 범위를 확인
                                    </MudListItem>
                                </MudList>
                            </MudStack>
                        </MudPaper>
                    }
                    <MudAlert Severity="Severity.Info">@의뢰.추천사유</MudAlert>
                    @if (의뢰.경고목록.Count > 0)
                    {
                        <MudAlert Severity="Severity.Warning">@string.Join(" · ", 의뢰.경고목록)</MudAlert>
                        <MudCheckBox T="bool" @bind-Value="_경고확인완료" Label="차량·화물 주의사항을 확인했습니다." />
                    }
                    @if (!string.IsNullOrWhiteSpace(_처리상태))
                    {
                        <MudAlert Severity="@_처리Severity">@_처리상태</MudAlert>
                    }
                    <MudStack Row="true" Spacing="2" Wrap="Wrap.Wrap">
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(의뢰.경고목록.Count > 0 && !_경고확인완료)" OnClick="Accept">수락</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="Hold">보류</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="Reject">거절</MudButton>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Href="@DriverRoutes.RecommendationDecision(의뢰Id)">배차 처리 화면</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.Recommendations">추천 목록으로</MudButton>
                    </MudStack>
                </MudStack>
            </MudPaper>

            <SsalddelDocumentOutputPanel Draft="@CreateWaybillDraft(의뢰)"
                                        Title="운송장 출력"
                                        Subtitle="추천 의뢰 정보를 인쇄 가능한 운송장으로 변환합니다."
                                        PanelClass="driver-recommendation-card pa-4" />
        }
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string 의뢰Id { get; set; } = string.Empty;

    private DriverRequestItem? 의뢰 => Samples.추천의뢰조회(의뢰Id);
    private string? _처리상태;
    private Severity _처리Severity = Severity.Info;
    private bool _데이터로딩중 = true;
    private bool _인증됨;
    private string? _데이터오류;
    private bool _경고확인완료;
    private string? _경고확인의뢰Id;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_경고확인의뢰Id, 의뢰Id, StringComparison.Ordinal))
        {
            _경고확인의뢰Id = 의뢰Id;
            _경고확인완료 = false;
        }

        await 데이터조회Async(force: false);
        현재결정표시();
    }

    private void 현재결정표시()
    {
        if (의뢰 is null)
        {
            return;
        }

        var decision = DecisionService.GetDecision(의뢰.의뢰Id);
        if (decision is not null)
        {
            _처리상태 = $"{decision.Decision} 처리됨 · {decision.DecidedAt:HH:mm} · {decision.Memo}";
            _처리Severity = decision.Decision switch
            {
                "수락" => Severity.Success,
                "거절" => Severity.Warning,
                _ => Severity.Info
            };
        }
    }

    private Task 재조회Async()
        => 데이터조회Async(force: true);

    private async Task 데이터조회Async(bool force)
    {
        _데이터로딩중 = true;
        _데이터오류 = null;

        try
        {
            await AuthSession.RestoreAsync();
            _인증됨 = AuthSession.IsAuthenticated;
            if (_인증됨)
            {
                await Samples.RefreshAsync(force: force);
            }
        }
        catch
        {
            _데이터오류 = "추천 상세를 불러오지 못했습니다. 네트워크와 서버 연결을 확인한 뒤 다시 시도해 주세요.";
        }
        finally
        {
            _데이터로딩중 = false;
        }
    }

    private async Task Accept()
    {
        if (의뢰 is null)
        {
            return;
        }

        try
        {
            var decision = await DecisionService.AcceptAsync(
                의뢰,
                _경고확인완료 ? 의뢰.확인필요경고코드 : []);
            _처리상태 = decision.Memo;
            _처리Severity = Severity.Success;
        }
        catch (Exception ex)
        {
            _처리상태 = ex.Message;
            _처리Severity = Severity.Error;
        }
    }

    private void Hold()
    {
        if (의뢰 is null)
        {
            return;
        }

        var decision = DecisionService.Hold(의뢰);
        _처리상태 = decision.Memo;
        _처리Severity = Severity.Info;
    }

    private async Task Reject()
    {
        if (의뢰 is null)
        {
            return;
        }

        try
        {
            var decision = await DecisionService.RejectAsync(의뢰, "추천 상세에서 거절");
            _처리상태 = decision.Memo;
            _처리Severity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _처리상태 = ex.Message;
            _처리Severity = Severity.Error;
        }
    }

    private DriverWarningBadgeState WarningState => DriverWarningBadgeStateFactory.Create(의뢰);

    private static SsalddelWaybillDocumentDraft CreateWaybillDraft(DriverRequestItem item)
    {
        var fare = item.예상수익 ?? 0m;
        var cost = item.예상총비용 ?? 0m;

        return new SsalddelWaybillDocumentDraft(
            item.의뢰Id,
            item.화물종류,
            item.운송조건표시,
            item.차량조건표시,
            item.픽업지,
            item.픽업지,
            item.상차시간표시,
            item.하차지,
            item.하차지,
            item.하차시간표시,
            item.결제방식,
            item.인수증필요,
            fare,
            cost,
            item.상세설명,
            DateTimeOffset.Now);
    }

    private static string PickupDistanceText(DriverRequestItem request)
        => $"상차지까지 {(request.픽업거리Km ?? 0m):0.0}km";

    private static string TransportDistanceText(DriverRequestItem request)
        => $"운송 {(request.운송거리Km ?? 0m):0.0}km";

    private static IReadOnlyList<string> PickupMeta(DriverRequestItem request)
        => [request.운송조건표시, request.차량조건표시, request.상차시간표시];

    private static IReadOnlyList<string> DropoffMeta(DriverRequestItem request)
        => [request.하차시간표시, request.인수증표시];

    private static IReadOnlyList<string> PaymentItems(DriverRequestItem request)
        => [request.결제방식, request.인수증표시, $"예상비용 {(request.예상총비용 ?? 0m):0}원"];
}
