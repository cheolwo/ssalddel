@page "/driver/recommendations/{의뢰Id}/decision"
@inject IDriverSampleDataService Samples
@inject IAuthSession AuthSession
@inject IDriverRecommendationDecisionService DecisionService

<PageTitle>배차처리</PageTitle>

<MudContainer MaxWidth="MaxWidth.Medium" Class="py-4">
    <MudStack Spacing="3">
        <MudPaper Class="driver-page-legacy-header pa-4" Elevation="1">
            <MudStack Spacing="1">
                <MudText Typo="Typo.h4">배차 처리</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">추천 상세를 본 다음 수락이나 거절을 처리하는 화면이다.</MudText>
            </MudStack>
        </MudPaper>

        <MudPaper Class="pa-4" Elevation="2">
            <MudStack Spacing="2">
                @if (_데이터로딩중)
                {
                    <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
                    <MudText Typo="Typo.body2" Color="Color.Secondary">처리할 추천 배차를 확인하고 있습니다.</MudText>
                }
                else if (!_인증됨)
                {
                    <MudAlert Severity="Severity.Warning">
                        배차 수락과 거절은 기사 로그인 후 처리할 수 있습니다.
                        <MudButton Class="ml-2"
                                   Variant="Variant.Filled"
                                   Color="Color.Primary"
                                   Href="@DriverRoutes.LoginFor(DriverRoutes.RecommendationDecision(의뢰Id))">
                            로그인하고 계속
                        </MudButton>
                    </MudAlert>
                }
                else if (!string.IsNullOrWhiteSpace(_데이터오류))
                {
                    <MudAlert Severity="Severity.Error">
                        @_데이터오류
                        <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" OnClick="재조회Async">다시 시도</MudButton>
                    </MudAlert>
                }
                else if (의뢰 is null)
                {
                    <MudAlert Severity="Severity.Warning">배차 처리할 추천 의뢰 정보를 찾지 못했습니다. 추천 목록에서 현재 제안을 다시 확인해 주세요.</MudAlert>
                }
                else
                {
                    <MudText Typo="Typo.h6">@의뢰.요약설명</MudText>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined">의뢰 @의뢰Id</MudChip>
                    <MudText Typo="Typo.body1">@의뢰.경로표시</MudText>
                    <MudText Typo="Typo.body2">예상수익 @((의뢰.예상수익 ?? 0m).ToString("0"))원 / 추천점수 @((의뢰.추천점수 ?? 0m).ToString("0"))점</MudText>
                    <MudAlert Severity="Severity.Info">서버 배차 처리 API로 수락, 보류, 거절 상태를 갱신합니다.</MudAlert>
                }
                @if (_인증됨 && string.IsNullOrWhiteSpace(_데이터오류) && !_데이터로딩중)
                {
                    <MudAlert Severity="@_처리Severity">@_처리상태</MudAlert>
                    @if (_거절입력표시)
                    {
                        <MudSelect T="string" Label="거절 사유" @bind-Value="_거절사유" Variant="Variant.Outlined">
                            <MudSelectItem T="string" Value="@("동선이 맞지 않음")">동선이 맞지 않음</MudSelectItem>
                            <MudSelectItem T="string" Value="@("시간 조건이 맞지 않음")">시간 조건이 맞지 않음</MudSelectItem>
                            <MudSelectItem T="string" Value="@("차량 조건이 맞지 않음")">차량 조건이 맞지 않음</MudSelectItem>
                            <MudSelectItem T="string" Value="@("수익성이 낮음")">수익성이 낮음</MudSelectItem>
                        </MudSelect>
                    }
                    <MudStack Row="true" Spacing="2">
                        @if (의뢰?.경고목록.Count > 0)
                        {
                            <MudAlert Severity="Severity.Warning">@string.Join(" · ", 의뢰.경고목록)</MudAlert>
                            <MudCheckBox T="bool" @bind-Value="_경고확인완료" Label="차량·화물 주의사항을 확인했습니다." />
                        }
                        <MudButton Variant="Variant.Filled" Color="Color.Success" Disabled="@(의뢰 is null || (의뢰.경고목록.Count > 0 && !_경고확인완료))" OnClick="배차수락">배차 수락</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Disabled="@(의뢰 is null)" OnClick="배차보류">보류</MudButton>
                        @if (_거절입력표시)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Error" Disabled="@(의뢰 is null)" OnClick="배차거절">거절 확정</MudButton>
                        }
                        else
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" Disabled="@(의뢰 is null)" OnClick="@(() => _거절입력표시 = true)">거절</MudButton>
                        }
                    </MudStack>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Href="@DriverRoutes.RecommendationDetail(의뢰Id)">추천 상세로</MudButton>
            </MudStack>
        </MudPaper>
    </MudStack>
</MudContainer>

@code {
    [Parameter]
    public string 의뢰Id { get; set; } = string.Empty;

    private DriverRequestItem? 의뢰 => Samples.추천의뢰조회(의뢰Id);
    private string _처리상태 = "아직 처리 전입니다.";
    private Severity _처리Severity = Severity.Normal;
    private bool _거절입력표시;
    private string _거절사유 = "동선이 맞지 않음";
    private bool _데이터로딩중 = true;
    private bool _인증됨;
    private string? _데이터오류;
    private bool _경고확인완료;
    private string? _경고확인의뢰Id;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_경고확인의뢰Id, 의뢰Id, StringComparison.Ordinal))
        {
            _경고확인의뢰Id = 의뢰Id;
            _경고확인완료 = false;
        }

        await 데이터조회Async(force: false);
        현재결정표시();
    }

    private void 현재결정표시()
    {
        if (의뢰 is null)
        {
            return;
        }

        var decision = DecisionService.GetDecision(의뢰.의뢰Id);
        if (decision is not null)
        {
            _처리상태 = $"{decision.Decision} 처리됨 · {decision.DecidedAt:HH:mm} · {decision.Memo}";
            _처리Severity = decision.Decision switch
            {
                "수락" => Severity.Success,
                "거절" => Severity.Warning,
                _ => Severity.Info
            };
        }
    }

    private Task 재조회Async()
        => 데이터조회Async(force: true);

    private async Task 데이터조회Async(bool force)
    {
        _데이터로딩중 = true;
        _데이터오류 = null;

        try
        {
            await AuthSession.RestoreAsync();
            _인증됨 = AuthSession.IsAuthenticated;
            if (_인증됨)
            {
                await Samples.RefreshAsync(force: force);
            }
        }
        catch
        {
            _데이터오류 = "추천 배차를 불러오지 못했습니다. 네트워크와 서버 연결을 확인한 뒤 다시 시도해 주세요.";
        }
        finally
        {
            _데이터로딩중 = false;
        }
    }

    private async Task 배차수락()
    {
        if (의뢰 is null)
        {
            return;
        }

        try
        {
            var decision = await DecisionService.AcceptAsync(
                의뢰,
                _경고확인완료 ? 의뢰.확인필요경고코드 : []);
            _처리상태 = decision.Memo;
            _처리Severity = Severity.Success;
        }
        catch (Exception ex)
        {
            _처리상태 = ex.Message;
            _처리Severity = Severity.Error;
        }
    }

    private void 배차보류()
    {
        if (의뢰 is null)
        {
            return;
        }

        var decision = DecisionService.Hold(의뢰);
        _처리상태 = decision.Memo;
        _처리Severity = Severity.Info;
    }

    private async Task 배차거절()
    {
        if (의뢰 is null)
        {
            return;
        }

        try
        {
            var decision = await DecisionService.RejectAsync(의뢰, _거절사유);
            _처리상태 = decision.Memo;
            _처리Severity = Severity.Warning;
        }
        catch (Exception ex)
        {
            _처리상태 = ex.Message;
            _처리Severity = Severity.Error;
        }
    }
}

