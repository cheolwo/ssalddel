    {
      "order": 7,
      "code": "ReadWorldResult",
      "question": "재고, 공간과 세계 상태의 결과를 이해할 수 있는가?"
    },
    {
      "order": 8,
      "code": "RecoverReturnOrChooseAgain",
      "question": "회복, 귀환 또는 달라진 다음 선택으로 이어지는가?"
    }
  ],
  "evidenceStageReview": [
