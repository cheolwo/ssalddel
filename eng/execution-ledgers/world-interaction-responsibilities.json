  "atomicBundles": [
    {
      "worldInteractionId": "WI-REVIEW-01",
      "reason": "업무 검토 완료와 운영 숙련 근거 확정은 같은 검토 결과에서 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-COMMUNITY-VISITOR-STAY",
      "reason": "방문자 결정·수용 칸·공동체 마음 계보는 하나의 수용 또는 거절 확정에서 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-FARM-04",
      "reason": "수확 Lot 생성과 재배 단위 수확 완료는 하나의 수확 원자성 안에서 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-FARM-06",
      "reason": "포장 Lot 생성과 같은 수량의 운송 Cargo 준비는 하나의 포장 결과를 보존하는 원자적 계보다."
    },
    {
      "worldInteractionId": "WI-FARM-DEFENSE-MOBILIZE",
      "reason": "분대 출동과 배정 작업자의 생산 기여 중단은 같은 방위 소집 확정에서 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-FARM-DEFENSE-RESOLVE",
      "reason": "전투 권위가 한 결과 묶음으로 확정한 위협 감소·안전 기간·생산/회복 보정·전리품은 같은 방어 성공 발현에서 원자적으로 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-002",
      "reason": "보관 용량 소비·작업 영역 해제·적재 완료는 하나의 적재 원자성을 지킨다."
    },
    {
      "worldInteractionId": "WI-NATURE-06",
      "reason": "나무가 쓰러지는 것과 그 나무에서 목재가 생기는 것은 하나의 벌목 결과다."
    },
    {
      "worldInteractionId": "WI-NATURE-08",
      "reason": "오두막 운영 시작과 승인된 회복·방어 능력 활성화는 같은 건설 완료 원자성이다."
    },
    {
      "worldInteractionId": "WI-NATURE-12",
      "reason": "작업 취소와 그 작업이 소유한 예약·미사용 자원 반환은 함께 성공하거나 함께 실패해야 한다."
    },
    {
      "worldInteractionId": "WI-NATURE-13",
      "reason": "목재 보관과 보관 계보 기록은 동일 자원 이동의 상태와 감사 기록이다."
    },
    {
      "worldInteractionId": "WI-NATURE-15",
      "reason": "확장 계획 선택으로 다음 날 선택 가능 상태가 열리는 것은 같은 결정의 직접 결과다."
    },
    {
      "worldInteractionId": "WI-NATURE-18",
      "reason": "지면 통나무의 수집 완료와 같은 수량의 소지 인벤토리 증가는 하나의 자원 이동으로 함께 성공하거나 함께 실패해야 한다."
    },
    {
      "worldInteractionId": "WI-NATURE-20",
      "reason": "통나무 2개 소비, 울타리 세 구간 수리와 생활 또는 이동 선택 개방은 한 수리 확정에서 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-CARD-01",
      "reason": "아르카나 활성화·방향 동결·영향 상태 사본 생성은 한 활성화 인스턴스의 불변 원자성이다."
    },
    {
      "worldInteractionId": "WI-WORLD-03",
      "reason": "업무 취소와 해당 업무가 소유한 예약 해제는 동일 취소 트랜잭션이다."
    },
    {
      "worldInteractionId": "WI-NATURE-HANS-BOUNDARY-PATROL",
      "reason": "공동 순찰 완료, 함께 귀환과 약속 이행 기록은 같은 공동 행동 계보에서 함께 성립해야 한다."
    },
    {
      "worldInteractionId": "WI-REFLECT-HANS-FARM-CRISIS-DEBRIEF",
      "reason": "위기 사후 성찰, 학습 필요 인식과 다음 캠페인 진입 가능성은 같은 성찰 결과에서 함께 성립한다."
    }
  ],
